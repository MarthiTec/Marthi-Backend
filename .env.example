NODE_ENV=development
PORT=8080
API_PREFIX=api/v1

# PostgreSQL
DATABASE_URL=postgresql://marthi:marthi@localhost:5432/marthi_totem?schema=public

# JWT (7 dias, alinhado ao frontend)
JWT_SECRET=troque-este-segredo-jwt-marthi
JWT_EXPIRES_IN=7d

# Auth de desenvolvimento (mesmo contrato da UI)
AUTH_DEV_EMAIL=teste@marthi.com.br
AUTH_DEV_PASSWORD=123
BCRYPT_SALT_ROUNDS=12

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=

# CORS — origens separadas por vírgula
CORS_ORIGINS=https://marthi-totem.discloud.app,http://localhost:5173

# Swagger
SWAGGER_ENABLED=true
