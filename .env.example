NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL
DATABASE_URL=postgresql://marthi:marthi@localhost:5432/marthi_totem?schema=public

# JWT
JWT_ACCESS_SECRET=troque-este-segredo-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Auth
ENABLE_PUBLIC_REGISTER=true
BCRYPT_SALT_ROUNDS=12

# CORS — origens separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger
SWAGGER_ENABLED=true
